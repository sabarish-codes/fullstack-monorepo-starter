{
  "compilerOptions": {
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "jest"],
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts", "server.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
